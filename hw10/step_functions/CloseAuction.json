{
  "Comment": "Stage C: schema v2, conditional transactions, durable success receipts; generated by scripts/build_workflows.py. Deploy as EXPRESS.",
  "QueryLanguage": "JSONata",
  "StartAt": "Validate",
  "TimeoutSeconds": 25,
  "States": {
    "Validate": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% ($type($states.input.auctionId) = 'string' ? $exists($match($states.input.auctionId, /^[A-Za-z0-9_-]{1,64}$/)) : false) and ($exists($states.input.requestId) ? ($type($states.input.requestId) = 'string' ? $exists($match($states.input.requestId, /^[A-Za-z0-9_-]{1,128}$/)) : false) : true) %}",
          "Next": "Initialize"
        }
      ],
      "Default": "InvalidInput"
    },
    "Initialize": {
      "Type": "Pass",
      "Assign": {
        "aid": "{% $states.input.auctionId %}",
        "rid": "{% $exists($states.input.requestId) ? $states.input.requestId : $states.context.Execution.Id %}",
        "principal": "{% $exists($states.input._principal) ? $states.input._principal : '' %}",
        "attempt": 0,
        "createdAt": "{% $now() %}"
      },
      "Next": "MakeIdentity"
    },
    "MakeIdentity": {
      "Type": "Pass",
      "Assign": {
        "requestKey": "{% 'CLOSE#' & ($principal != '' ? $principal & '#' : '') & $rid %}",
        "fingerprint": "{% $string({'auctionId':$aid}) %}"
      },
      "Next": "ReadReceipt"
    },
    "ReadReceipt": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem",
      "Arguments": {
        "TableName": "${RequestsTable}",
        "Key": {
          "requestKey": {
            "S": "{% $requestKey %}"
          }
        },
        "ConsistentRead": true
      },
      "Next": "ReceiptExists",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Unavailable"
        }
      ],
      "Assign": {
        "receipt": "{% $exists($states.result.Item) ? $states.result.Item : {} %}"
      }
    },
    "ReceiptExists": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($receipt.requestKey.S) %}",
          "Next": "MatchReceipt"
        }
      ],
      "Default": "AttemptLimit"
    },
    "MatchReceipt": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $receipt.fingerprint.S = $fingerprint %}",
          "Next": "ReturnReceipt"
        }
      ],
      "Default": "RequestConflict"
    },
    "ReturnReceipt": {
      "Type": "Pass",
      "End": true,
      "Output": "{% $parse($receipt.response.S) %}"
    },
    "AttemptLimit": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $attempt >= 3 %}",
          "Next": "Unavailable"
        }
      ],
      "Default": "ReadAuction"
    },
    "ReadAuction": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem",
      "Arguments": {
        "TableName": "${AuctionsTable}",
        "Key": {
          "auctionId": {
            "S": "{% $aid %}"
          }
        },
        "ConsistentRead": true
      },
      "Next": "AuctionExists",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Unavailable"
        }
      ],
      "Assign": {
        "auction": "{% $exists($states.result.Item) ? $states.result.Item : {} %}"
      }
    },
    "AuctionExists": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($auction.auctionId.S) %}",
          "Next": "SchemaReady"
        }
      ],
      "Default": "AuctionNotExist"
    },
    "SchemaReady": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $auction.schemaVersion.N = '2' and $exists($auction.version.N) and $exists($auction.highestBid.N) and $exists($auction.highestBidUserId.S) %}",
          "Next": "OwnerOnly"
        }
      ],
      "Default": "MigrationRequired"
    },
    "AuctionOpen": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $auction.auctionStatus.S = 'OPEN' %}",
          "Next": "HasBid"
        }
      ],
      "Default": "AuctionClosed"
    },
    "ReadUser": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem",
      "Arguments": {
        "TableName": "${UsersTable}",
        "Key": {
          "userId": {
            "S": "{% $uid %}"
          }
        },
        "ConsistentRead": true
      },
      "Next": "UserExists",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Unavailable"
        }
      ],
      "Assign": {
        "user": "{% $exists($states.result.Item) ? $states.result.Item : {} %}"
      }
    },
    "UserExists": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($user.userId.S) %}",
          "Next": "BalanceEnough"
        }
      ],
      "Default": "InvalidUser"
    },
    "BalanceEnough": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $number($user.acctBalance.N) >= $amount %}",
          "Next": "PlanTransaction"
        }
      ],
      "Default": "InsufficientFunds"
    },
    "WaitForConflict": {
      "Type": "Wait",
      "Seconds": 1,
      "Next": "ReadReceipt"
    },
    "ReturnSuccess": {
      "Type": "Pass",
      "End": true,
      "Output": "{% $response %}"
    },
    "InvalidInput": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "InvalidInput",
        "message": "Valid auctionId, userId/bidAmt (for bids), and optional requestId are required",
        "httpStatus": 400,
        "retryable": false
      }
    },
    "RequestConflict": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "IdempotencyConflict",
        "message": "requestId was already committed with a different payload",
        "httpStatus": 409,
        "retryable": false
      }
    },
    "MigrationRequired": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "MigrationRequired",
        "message": "Auction requires an offline schema migration before writes are allowed",
        "httpStatus": 409,
        "retryable": false
      }
    },
    "AuctionNotExist": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "AuctionNotExist",
        "message": "Auction does not exist",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "AuctionClosed": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "AuctionClosed",
        "message": "Auction is already closed",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "InvalidUser": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "invalid_user",
        "message": "User does not exist",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "InsufficientFunds": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "insufficient_funds",
        "message": "Insufficient funds",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "Unavailable": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "RetryableFailure",
        "message": "Outcome may be unknown. Retry the identical request with the same requestId.",
        "httpStatus": 503,
        "retryable": true
      }
    },
    "OwnerOnly": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $principal = '' or $auction.ownerId.S = $principal %}",
          "Next": "AuctionOpen"
        }
      ],
      "Default": "Forbidden"
    },
    "Forbidden": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "Forbidden",
        "message": "Only the auction creator can close this auction",
        "httpStatus": 403,
        "retryable": false
      }
    },
    "HasBid": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $number($auction.highestBid.N) > 0 and $auction.highestBidUserId.S != '' %}",
          "Next": "ReserveMet"
        }
      ],
      "Default": "BidNotExist"
    },
    "ReserveMet": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $number($auction.highestBid.N) >= $number($auction.reserve.N) %}",
          "Next": "SelectWinner"
        }
      ],
      "Default": "ReserveNotMet"
    },
    "SelectWinner": {
      "Type": "Pass",
      "Assign": {
        "amount": "{% $number($auction.highestBid.N) %}",
        "uid": "{% $auction.highestBidUserId.S %}"
      },
      "Next": "ReadUser"
    },
    "BidNotExist": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "BidNotExist",
        "message": "No bids placed yet",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "ReserveNotMet": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "ReserveNotMet",
        "message": "Reserve not met",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "PlanTransaction": {
      "Type": "Pass",
      "Assign": {
        "response": {
          "accepted": true,
          "auctionId": "{% $aid %}",
          "winningUserId": "{% $uid %}",
          "winningBid": "{% $amount %}",
          "requestId": "{% $rid %}",
          "message": "Auction closed"
        },
        "token": "{% $uuid() %}"
      },
      "Next": "Commit"
    },
    "Commit": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:transactWriteItems",
      "Arguments": {
        "ClientRequestToken": "{% $token %}",
        "TransactItems": [
          {
            "Update": {
              "TableName": "${AuctionsTable}",
              "Key": {
                "auctionId": {
                  "S": "{% $aid %}"
                }
              },
              "ExpressionAttributeValues": {
                ":open": {
                  "S": "OPEN"
                },
                ":version": {
                  "N": "{% $auction.version.N %}"
                },
                ":one": {
                  "N": "1"
                },
                ":amount": {
                  "N": "{% $formatNumber($amount,'0.00') %}"
                },
                ":uid": {
                  "S": "{% $uid %}"
                },
                ":closed": {
                  "S": "CLOSED"
                },
                ":result": {
                  "S": "{% $string($response) %}"
                }
              },
              "ConditionExpression": "auctionStatus = :open AND version = :version AND highestBid = :amount AND highestBidUserId = :uid AND reserve <= :amount",
              "UpdateExpression": "SET version = version + :one, auctionStatus = :closed, winningUserId = :uid, winningBid = :amount, closeResult = :result"
            }
          },
          {
            "Update": {
              "TableName": "${UsersTable}",
              "Key": {
                "userId": {
                  "S": "{% $uid %}"
                }
              },
              "ConditionExpression": "attribute_exists(userId) AND acctBalance >= :amount",
              "UpdateExpression": "SET acctBalance = acctBalance - :amount",
              "ExpressionAttributeValues": {
                ":amount": {
                  "N": "{% $formatNumber($amount,'0.00') %}"
                }
              }
            }
          },
          {
            "Put": {
              "TableName": "${RequestsTable}",
              "ConditionExpression": "attribute_not_exists(requestKey)",
              "Item": {
                "requestKey": {
                  "S": "{% $requestKey %}"
                },
                "fingerprint": {
                  "S": "{% $fingerprint %}"
                },
                "response": {
                  "S": "{% $string($response) %}"
                },
                "createdAt": {
                  "S": "{% $createdAt %}"
                }
              }
            }
          }
        ]
      },
      "Next": "ReturnSuccess",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "attempt": "{% $attempt + 1 %}"
          },
          "Next": "WaitForConflict"
        }
      ]
    }
  }
}
