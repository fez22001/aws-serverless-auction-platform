{
  "Comment": "Stage C: schema v2, conditional transactions, durable success receipts; generated by scripts/build_workflows.py. Deploy as EXPRESS.",
  "QueryLanguage": "JSONata",
  "StartAt": "Validate",
  "TimeoutSeconds": 25,
  "States": {
    "Validate": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% ($type($states.input.auctionId) = 'string' ? $exists($match($states.input.auctionId, /^[A-Za-z0-9_-]{1,64}$/)) : false) and ($exists($states.input.requestId) ? ($type($states.input.requestId) = 'string' ? $exists($match($states.input.requestId, /^[A-Za-z0-9_-]{1,128}$/)) : false) : true) and ($type($states.input.userId) = 'string' ? $exists($match($states.input.userId, /^[A-Za-z0-9_-]{1,64}$/)) : false) and ($type($states.input.bidAmt) = 'number' ? ($states.input.bidAmt > 0 and $states.input.bidAmt <= 1000000000 and $round($states.input.bidAmt, 2) = $states.input.bidAmt) : false) %}",
          "Next": "Initialize"
        }
      ],
      "Default": "InvalidInput"
    },
    "Initialize": {
      "Type": "Pass",
      "Assign": {
        "aid": "{% $states.input.auctionId %}",
        "rid": "{% $exists($states.input.requestId) ? $states.input.requestId : $states.context.Execution.Id %}",
        "principal": "{% $exists($states.input._principal) ? $states.input._principal : '' %}",
        "attempt": 0,
        "createdAt": "{% $now() %}",
        "uid": "{% $states.input.userId %}",
        "amount": "{% $states.input.bidAmt %}"
      },
      "Next": "MakeIdentity"
    },
    "MakeIdentity": {
      "Type": "Pass",
      "Assign": {
        "requestKey": "{% 'BID#' & ($principal != '' ? $principal & '#' : '') & $rid %}",
        "fingerprint": "{% $string({'auctionId':$aid,'userId':$uid,'bidAmt':$formatNumber($amount,'0.00')}) %}"
      },
      "Next": "ReadReceipt"
    },
    "ReadReceipt": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem",
      "Arguments": {
        "TableName": "${RequestsTable}",
        "Key": {
          "requestKey": {
            "S": "{% $requestKey %}"
          }
        },
        "ConsistentRead": true
      },
      "Next": "ReceiptExists",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Unavailable"
        }
      ],
      "Assign": {
        "receipt": "{% $exists($states.result.Item) ? $states.result.Item : {} %}"
      }
    },
    "ReceiptExists": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($receipt.requestKey.S) %}",
          "Next": "MatchReceipt"
        }
      ],
      "Default": "AttemptLimit"
    },
    "MatchReceipt": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $receipt.fingerprint.S = $fingerprint %}",
          "Next": "ReturnReceipt"
        }
      ],
      "Default": "RequestConflict"
    },
    "ReturnReceipt": {
      "Type": "Pass",
      "End": true,
      "Output": "{% $parse($receipt.response.S) %}"
    },
    "AttemptLimit": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $attempt >= 3 %}",
          "Next": "Unavailable"
        }
      ],
      "Default": "ReadAuction"
    },
    "ReadAuction": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem",
      "Arguments": {
        "TableName": "${AuctionsTable}",
        "Key": {
          "auctionId": {
            "S": "{% $aid %}"
          }
        },
        "ConsistentRead": true
      },
      "Next": "AuctionExists",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Unavailable"
        }
      ],
      "Assign": {
        "auction": "{% $exists($states.result.Item) ? $states.result.Item : {} %}"
      }
    },
    "AuctionExists": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($auction.auctionId.S) %}",
          "Next": "SchemaReady"
        }
      ],
      "Default": "AuctionNotExist"
    },
    "SchemaReady": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $auction.schemaVersion.N = '2' and $exists($auction.version.N) and $exists($auction.highestBid.N) and $exists($auction.highestBidUserId.S) %}",
          "Next": "AuctionOpen"
        }
      ],
      "Default": "MigrationRequired"
    },
    "AuctionOpen": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $auction.auctionStatus.S = 'OPEN' %}",
          "Next": "CheckBid"
        }
      ],
      "Default": "AuctionClosed"
    },
    "ReadUser": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem",
      "Arguments": {
        "TableName": "${UsersTable}",
        "Key": {
          "userId": {
            "S": "{% $uid %}"
          }
        },
        "ConsistentRead": true
      },
      "Next": "UserExists",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Unavailable"
        }
      ],
      "Assign": {
        "user": "{% $exists($states.result.Item) ? $states.result.Item : {} %}"
      }
    },
    "UserExists": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $exists($user.userId.S) %}",
          "Next": "BalanceEnough"
        }
      ],
      "Default": "InvalidUser"
    },
    "BalanceEnough": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $number($user.acctBalance.N) >= $amount %}",
          "Next": "PlanTransaction"
        }
      ],
      "Default": "InsufficientFunds"
    },
    "WaitForConflict": {
      "Type": "Wait",
      "Seconds": 1,
      "Next": "ReadReceipt"
    },
    "ReturnSuccess": {
      "Type": "Pass",
      "End": true,
      "Output": "{% $response %}"
    },
    "InvalidInput": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "InvalidInput",
        "message": "Valid auctionId, userId/bidAmt (for bids), and optional requestId are required",
        "httpStatus": 400,
        "retryable": false
      }
    },
    "RequestConflict": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "IdempotencyConflict",
        "message": "requestId was already committed with a different payload",
        "httpStatus": 409,
        "retryable": false
      }
    },
    "MigrationRequired": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "MigrationRequired",
        "message": "Auction requires an offline schema migration before writes are allowed",
        "httpStatus": 409,
        "retryable": false
      }
    },
    "AuctionNotExist": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "AuctionNotExist",
        "message": "Auction does not exist",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "AuctionClosed": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "AuctionClosed",
        "message": "Auction is already closed",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "InvalidUser": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "invalid_user",
        "message": "User does not exist",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "InsufficientFunds": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "insufficient_funds",
        "message": "Insufficient funds",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "Unavailable": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "RetryableFailure",
        "message": "Outcome may be unknown. Retry the identical request with the same requestId.",
        "httpStatus": 503,
        "retryable": true
      }
    },
    "CheckBid": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $amount > $number($auction.highestBid.N) %}",
          "Next": "ReadUser"
        }
      ],
      "Default": "InvalidBid"
    },
    "InvalidBid": {
      "Type": "Pass",
      "End": true,
      "Output": {
        "accepted": false,
        "reason": "invalid_bid",
        "message": "Bid must strictly exceed the current highest bid",
        "httpStatus": 200,
        "retryable": false
      }
    },
    "PlanTransaction": {
      "Type": "Pass",
      "Assign": {
        "response": {
          "accepted": true,
          "auctionId": "{% $aid %}",
          "userId": "{% $uid %}",
          "bidAmt": "{% $amount %}",
          "requestId": "{% $rid %}",
          "message": "Bid accepted",
          "notification": "queued"
        },
        "token": "{% $uuid() %}",
        "eventPayload": "{% $string({'eventId':$requestKey,'type':'NewHighestBid','auctionId':$aid,'userId':$uid,'bidAmt':$amount,'date':$createdAt}) %}"
      },
      "Next": "Commit"
    },
    "Commit": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:transactWriteItems",
      "Arguments": {
        "ClientRequestToken": "{% $token %}",
        "TransactItems": [
          {
            "Update": {
              "TableName": "${AuctionsTable}",
              "Key": {
                "auctionId": {
                  "S": "{% $aid %}"
                }
              },
              "ExpressionAttributeValues": {
                ":open": {
                  "S": "OPEN"
                },
                ":version": {
                  "N": "{% $auction.version.N %}"
                },
                ":one": {
                  "N": "1"
                },
                ":amount": {
                  "N": "{% $formatNumber($amount,'0.00') %}"
                },
                ":uid": {
                  "S": "{% $uid %}"
                }
              },
              "ConditionExpression": "auctionStatus = :open AND version = :version AND highestBid < :amount",
              "UpdateExpression": "SET version = version + :one, highestBid = :amount, highestBidUserId = :uid"
            }
          },
          {
            "ConditionCheck": {
              "TableName": "${UsersTable}",
              "Key": {
                "userId": {
                  "S": "{% $uid %}"
                }
              },
              "ConditionExpression": "attribute_exists(userId) AND acctBalance >= :amount",
              "ExpressionAttributeValues": {
                ":amount": {
                  "N": "{% $formatNumber($amount,'0.00') %}"
                }
              }
            }
          },
          {
            "Put": {
              "TableName": "${RequestsTable}",
              "ConditionExpression": "attribute_not_exists(requestKey)",
              "Item": {
                "requestKey": {
                  "S": "{% $requestKey %}"
                },
                "fingerprint": {
                  "S": "{% $fingerprint %}"
                },
                "response": {
                  "S": "{% $string($response) %}"
                },
                "createdAt": {
                  "S": "{% $createdAt %}"
                }
              }
            }
          },
          {
            "Put": {
              "TableName": "${BidsTable}",
              "ConditionExpression": "attribute_not_exists(auctionId)",
              "Item": {
                "auctionId": {
                  "S": "{% $aid %}"
                },
                "bidAmt": {
                  "N": "{% $formatNumber($amount,'0.00') %}"
                },
                "userId": {
                  "S": "{% $uid %}"
                },
                "date": {
                  "S": "{% $createdAt %}"
                },
                "requestId": {
                  "S": "{% $rid %}"
                }
              }
            }
          },
          {
            "Put": {
              "TableName": "${OutboxTable}",
              "ConditionExpression": "attribute_not_exists(eventId)",
              "Item": {
                "eventId": {
                  "S": "{% $requestKey %}"
                },
                "payload": {
                  "S": "{% $eventPayload %}"
                },
                "deliveryStatus": {
                  "S": "PENDING"
                },
                "createdAt": {
                  "S": "{% $createdAt %}"
                }
              }
            }
          }
        ]
      },
      "Next": "PublishNotification",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "attempt": "{% $attempt + 1 %}"
          },
          "Next": "WaitForConflict"
        }
      ]
    },
    "PublishNotification": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "${HighBidTopicArn}",
        "Message": "{% $eventPayload %}"
      },
      "Next": "MarkSent",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ReturnSuccess"
        }
      ]
    },
    "MarkSent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:updateItem",
      "Arguments": {
        "TableName": "${OutboxTable}",
        "Key": {
          "eventId": {
            "S": "{% $requestKey %}"
          }
        },
        "UpdateExpression": "SET deliveryStatus = :sent",
        "ConditionExpression": "deliveryStatus = :pending",
        "ExpressionAttributeValues": {
          ":sent": {
            "S": "SENT"
          },
          ":pending": {
            "S": "PENDING"
          }
        }
      },
      "Next": "ReturnSuccess",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ReturnSuccess"
        }
      ]
    }
  }
}
