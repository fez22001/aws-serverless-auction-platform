# Synthetic local mock. Start with: python3 local/mock_api.py (from project root).
# VITE_* values are public browser configuration; never put AWS credentials here.
VITE_REACT_APP_API_BASE=http://127.0.0.1:8000
VITE_LOCAL_MOCK=true

# Cloud publishing supplies these public Cognito identifiers from stack outputs.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
